        pkg:ads_bibcode "2024A&A...691A.318E" ;
        pkg:ads_keywords "asteroseismology; cosmological parameters; cosmology: observations; cosmology: theory; dark energy; large-scale structure of Universe; Astrophysics - Cosmology and Nongalactic Astrophysics" ;
        pkg:ads_url "https://ui.adsabs.harvard.edu/abs/2024A&A...691A.318E/abstract" ;
        pkg:arxiv_id "2310.15731" ;
