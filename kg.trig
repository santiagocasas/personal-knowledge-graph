        pkg:ads_keywords "techniques: photometric; astrometry; proper motions; globular clusters: individual: NGC6397; Astrophysics - Solar and Stellar Astrophysics; Astrophysics - Astrophysics of Galaxies; Astrophysics - Instrumentation and Methods for Astrophysics" ;
