            "10.48550/arxiv.1508.07208",
            "1508.07208",
            "2016JCAP...01..045C" ;
        schema:name "Fitting and forecasting coupled dark energy in the non-linear regime" ;
        pkg:ads_bibcode "2016JCAP...01..045C" ;
        pkg:ads_keywords "Astrophysics - Cosmology and Nongalactic Astrophysics" ;
        pkg:ads_url "https://ui.adsabs.harvard.edu/abs/2016JCAP...01..045C/abstract" ;
        pkg:arxiv_id "1508.07208" ;
        pkg:author_count 5 ;
        pkg:author_list "Casas, Santiago; Amendola, Luca; Baldi, Marco; Pettorino, Valeria; Vollmer, Adrian" ;
        pkg:author_list_incomplete false ;
        pkg:canonical_id "paper:doi:10.1088/1475-7516/2016/01/045" ;
        pkg:citation_count 26 ;
        pkg:description "We consider cosmological models in which dark matter feels a fifth force mediated by the dark energy scalar field, also known as coupled dark energy. Our interest resides in estimating forecasts for future surveys like Euclid when we take into account non-linear effects, relying on new fitting functions that reproduce the non-linear matter power spectrum obtained from N-body simulations." ;
        pkg:doi "https://doi.org/10.1088/1475-7516/2016/01/045" ;
        pkg:entry_type "journal-article" ;
        pkg:journal "JCAP" ;
        pkg:publication "Journal of Cosmology and Astroparticle Physics" ;
        pkg:publication_year 2016 ;
        pkg:source_url "https://orcid.org/0000-0002-4751-5138" .
}

