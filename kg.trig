    <https://w3id.org/personal-kg/resource/paper%3Aorcid%3A8f1ee4851e410fe3a0b7> a bibo:AcademicArticle ;
        schema:alternateName "0000-0002-4751-5138/67638340" ;
        schema:name "Euclid: On the reduced shear approximation and magnification bias for Stage IV cosmic shear experiments" ;
        pkg:authored_by <https://w3id.org/personal-kg/resource/person%3Aname%3As-casas> ;
        pkg:canonical_id "paper:orcid:8f1ee4851e410fe3a0b7" ;
        pkg:entry_type "journal-article" ;
