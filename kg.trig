        schema:name "Euclid: Early Release Observations ─ Overview of the Perseus cluster and analysis of its luminosity and stellar mass functions" ;
        pkg:ads_bibcode "2025A&A...697A..11C" ;
        pkg:ads_keywords "galaxies: fundamental parameters; galaxies: clusters: individual: Perseus; galaxies: luminosity function; mass function; Astrophysics of Galaxies" ;
