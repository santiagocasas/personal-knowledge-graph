        pkg:author_list_incomplete false ;
        pkg:authored_by <https://w3id.org/personal-kg/resource/person%3Aname%3Ab-gillis>,
            <https://w3id.org/personal-kg/resource/person%3Aname%3Ad-scognamiglio>,
            <https://w3id.org/personal-kg/resource/person%3Aname%3Ah-hoekstra>,
            <https://w3id.org/personal-kg/resource/person%3Aname%3Am-tewes>,
