# Blablador LLM API (https://helmholtz-blablador.fz-juelich.de/)
BLABLADOR_API_KEY=your_blablador_key_here

# NASA ADS Developer API (https://ui.adsabs.harvard.edu/user/settings/token)
ADS_API_TOKEN=your_ads_token_here

# Researcher identity used to bootstrap the curated My Papers scope
ORCID_ID=0000-0000-0000-0000
INSPIRE_AUTHOR_ID=1075089

# Anytype desktop app API key (Settings → API Keys → Create new)
ANYTYPE_API_KEY=your_anytype_key_here

# Anytype API base URL (desktop app exposes this locally)
ANYTYPE_API_URL=http://localhost:31009
ANYTYPE_BASE_URL=http://localhost:31009

# Target Anytype space
ANYTYPE_SPACE_ID=your_anytype_space_id_here

# Optional: helper location and tag property override
ANYTYPE_HELPER_DIR=../anytype-agents-skill
ANYTYPE_TAG_PROPERTY_ID=
# Note: BLABLADOR_API_KEY can also be set as a system env var instead of here
